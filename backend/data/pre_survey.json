{
  "title": "前测问卷",
  "description": "在开始审核案例之前，请回答以下背景问题，约 3—4 分钟。",
  "items": [
    {
      "id": "specialty",
      "type": "select",
      "label": "您的主要科室 / 专科",
      "required": true,
      "options": [
        "心血管内科",
        "呼吸内科",
        "消化内科",
        "内分泌科",
        "肾内科",
        "神经内科",
        "血液内科",
        "风湿免疫科",
        "感染科",
        "普通外科",
        "骨科",
        "神经外科",
        "胸外科",
        "泌尿外科",
        "心脏外科",
        "整形外科",
        "妇产科",
        "儿科",
        "急诊医学科",
        "全科医学科",
        "重症医学科",
        "麻醉科",
        "影像科",
        "检验科",
        "病理科",
        "中医科",
        "中西医结合",
        "其他"
      ]
    },
    {
      "id": "training_level",
      "type": "select",
      "label": "您当前的培训层级",
      "required": true,
      "options": [
        "医学生（本科 / 硕士 / 博士）",
        "规培住院医师（一阶段）",
        "规培住院医师（二阶段 / 专培）",
        "主治医师",
        "副主任医师",
        "主任医师"
      ]
    },
    {
      "id": "years_practice",
      "type": "number",
      "label": "完成培训后从医的年数（如尚在培训中请填 0）",
      "required": true,
      "min": 0,
      "max": 60
    },
    {
      "id": "weekly_message_volume",
      "type": "select",
      "label": "您平均每周需要处理的线上问诊或患者消息数量",
      "required": true,
      "options": [
        "0",
        "1—10 条",
        "11—25 条",
        "26—50 条",
        "51—100 条",
        "100 条以上"
      ]
    },
    {
      "id": "prior_ai_use",
      "type": "select",
      "label": "您此前在临床工作中是否使用过 AI 辅助工具（如生成式 AI 起草回复 / 撰写病历）",
      "required": true,
      "options": [
        "从未使用",
        "偶尔使用",
        "每月使用",
        "每周使用",
        "每天使用"
      ]
    },
    {
      "id": "ai_brands_used",
      "type": "multi_select",
      "label": "您接触或使用过哪些 AI 工具？（可多选）",
      "required": false,
      "options": [
        "DeepSeek",
        "文心一言",
        "通义千问",
        "智谱清言",
        "讯飞星火",
        "Kimi",
        "豆包",
        "ChatGPT",
        "其他海外模型",
        "未接触过"
      ]
    },
    {
      "id": "ai_familiarity",
      "type": "likert",
      "label": "您对生成式 AI 起草工具的工作原理熟悉程度如何？",
      "required": true,
      "scale": {
        "min": 1,
        "max": 7,
        "minLabel": "完全不熟悉",
        "maxLabel": "非常熟悉"
      }
    }
  ]
}
