# Top-level .env used by docker-compose.
# Copy to .env and fill in real values before running `docker compose up`.

# --- Backend admin auth ---
ADMIN_TOKEN=change-me-in-production

# --- LLM provider ---
# disabled = no LLM (default safe)
# deepseek = DeepSeek (requires DEEPSEEK_API_KEY) or DryRunProvider when LLM_DRY_RUN=true
LLM_PROVIDER=disabled
LLM_DRY_RUN=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Postgres (prod compose only) ---
POSTGRES_USER=medai
POSTGRES_DB=medai
POSTGRES_PASSWORD=please-change-me

# --- Backups ---
BACKUP_INTERVAL_SECONDS=86400

# --- Frontend (prod compose Phase 3) ---
NEXT_PUBLIC_API_BASE=/api
