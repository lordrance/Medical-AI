# Production .env template. Used by docker-compose.prod.yml.
#
# Generated by deploy/setup.sh on first run. Copy or rename to `.env`
# and edit values; values marked REQUIRED have no safe defaults.
#
# DO NOT COMMIT THE REAL .env — it is gitignored.

# --- Public hostname Caddy will get a Let's Encrypt cert for. -------
# For the cheapest deployment (no purchased domain) use a nip.io
# address built from your server's public IPv4, with dots replaced by
# dashes. Example: server IP 43.155.12.34 -> 43-155-12-34.nip.io
# nip.io is a free public DNS service that auto-resolves any IP-
# encoded hostname back to that IP. Let's Encrypt issues real certs for it.
SITE_DOMAIN=REQUIRED-set-to-your-nip.io-or-real-domain

# Optional: email for Let's Encrypt account (renewal reminders).
ACME_EMAIL=

# --- Admin token (used to log in to /admin and download data). ------
# Required. Set to a long random string. setup.sh generates one for you.
ADMIN_TOKEN=REQUIRED-strong-random-string

# --- CORS origins (JSON array of allowed Origins for browser requests).
# Default "*" is fine for a short-term study; tighten if needed.
CORS_ORIGINS=["*"]

# --- Postgres ------------------------------------------------------
POSTGRES_USER=medai
POSTGRES_DB=medai
POSTGRES_PASSWORD=REQUIRED-strong-random-string

# --- LLM ----------------------------------------------------------
# V4 hardcodes the AI draft at the application layer, so the LLM is
# never invoked during participant case rendering — leave disabled
# unless you also want the admin /api/admin/llm/cohort-summary endpoint
# to actually call DeepSeek for natural-language report generation.
LLM_PROVIDER=disabled
LLM_DRY_RUN=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Backups ------------------------------------------------------
# Seconds between automatic pg_dump runs inside the `backup` container.
# 86400 = once per day. Output goes to ./backups/ on the host.
BACKUP_INTERVAL_SECONDS=86400
