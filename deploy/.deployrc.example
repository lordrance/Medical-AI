# 部署配置 — 复制为 .deployrc 并填上你的真实服务器信息
# .deployrc 已加入 .gitignore，不会被提交

SERVER_IP=43.155.12.34          # 你的腾讯云服务器公网 IP
SERVER_USER=root                 # SSH 登录用户名（通常是 root）
SSH_KEY=~/.ssh/id_rsa           # SSH 私钥路径
REPO_DIR=~/Medical-AI           # 服务器上仓库的路径
BRANCH=V4                       # 部署哪个分支
